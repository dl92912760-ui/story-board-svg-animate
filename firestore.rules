rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHistoryProduction(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 600 &&
             data.era is string && data.era.size() <= 100 &&
             data.summary is string && data.summary.size() <= 1200 &&
             data.generationType in ['video', 'svg'] &&
             data.backgroundTheme in ['light', 'dark'] &&
             data.visualStyle is string && data.visualStyle.size() >= 1 && data.visualStyle.size() <= 60 &&
             data.aspectRatio in ['16:9', '9:16', '1:1'] &&
             data.totalDurationSeconds is int && data.totalDurationSeconds >= 1 && data.totalDurationSeconds <= 300 &&
             data.scenes is list && data.scenes.size() >= 1 && data.scenes.size() <= 8 &&
             data.scenes[0] is map &&
             data.scenes[0].svgCode is string && data.scenes[0].svgCode.size() >= 1 && data.scenes[0].svgCode.size() <= 120000 &&
             data.favorite is bool;
    }

    match /users/{userId}/histories/{historyId} {
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(historyId) &&
                    request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(historyId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'prompt', 'era', 'summary',
                         'generationType', 'backgroundTheme', 'visualStyle',
                         'aspectRatio', 'totalDurationSeconds', 'scenes',
                         'favorite', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'prompt', 'era', 'summary',
                         'generationType', 'backgroundTheme', 'visualStyle',
                         'aspectRatio', 'totalDurationSeconds', 'scenes',
                         'favorite', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidHistoryProduction(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(historyId) &&
                       request.auth.uid == userId &&
                       isValidHistoryProduction(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['favorite', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['backgroundTheme', 'scenes', 'totalDurationSeconds', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'era', 'summary', 'updatedAt'])
                       );

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(historyId) &&
                       request.auth.uid == userId;
    }
  }
}
